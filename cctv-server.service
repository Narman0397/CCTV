[Unit]
Description=cctv-server — AI video surveillance (RTSP ingest, NVR, YOLO detection, dashboard)
Documentation=file:///opt/cctv-server/docs/README.md https://github.com/cctv-server/cctv-server
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=cctv
Group=cctv
# secrets.env stays mode 0600 root:root; systemd reads it as root and
# passes any KEY=VALUE entries to the service environment. No secret is
# required at runtime (sessions are opaque server-side tokens).
EnvironmentFile=/etc/cctv-server/secrets.env
ExecStart=/opt/cctv-server/bin/cctv-server serve --config /etc/cctv-server/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

# --- hardening (see systemd-analyze security cctv-server.service) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
# Service only needs Internet + local sockets (RTSP clients, HTTP/WS API,
# ffmpeg child pipes). Block raw packet / netlink / exotic families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# --- writable paths only (least privilege) ---
ReadWritePaths=/var/lib/cctv-server /var/log/cctv-server

# --- resource limits for the 4 GB reference box ---
LimitNOFILE=65536
LimitNPROC=1024
TasksMax=512

[Install]
WantedBy=multi-user.target
