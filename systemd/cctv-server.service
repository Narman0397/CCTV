[Unit]
Description=cctv-server — AI video surveillance (RTSP ingest, NVR, YOLO detection, dashboard)
Documentation=file:///opt/cctv-server/docs/README.md https://github.com/Narman0397/CCTV
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=cctv
Group=cctv
# iGPU decode (VAAPI/QSV) needs /dev/dri and group render/video
SupplementaryGroups=video render
EnvironmentFile=-/etc/cctv-server/secrets.env
Environment=PATH=/opt/cctv-server/bin:/usr/local/bin:/usr/bin:/bin
# Optional: matching libonnxruntime.so (OpenVINO EP beside it). Uncomment via drop-in.
# Environment=ORT_DYLIB_PATH=/opt/cctv-server/lib/libonnxruntime.so
# Environment=LD_LIBRARY_PATH=/opt/cctv-server/lib
ExecStart=/opt/cctv-server/bin/cctv-server serve --config /etc/cctv-server/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
DeviceAllow=/dev/dri rw
DeviceAllow=char-drm rw

ReadWritePaths=/var/lib/cctv-server /var/log/cctv-server
ReadOnlyPaths=/opt/cctv-server

LimitNOFILE=65536
LimitNPROC=1024
TasksMax=512

[Install]
WantedBy=multi-user.target
