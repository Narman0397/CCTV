[Unit]
Description=cctv-server — AI video surveillance (RTSP ingest, NVR, YOLO detection, dashboard)
Documentation=file:///opt/cctv-server/docs/README.md https://github.com/Narman0397/CCTV
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=cctv
Group=cctv
# Optional secrets file (mode 0600 root:root). Leading '-' means missing file is not fatal.
EnvironmentFile=-/etc/cctv-server/secrets.env
ExecStart=/opt/cctv-server/bin/cctv-server serve --config /etc/cctv-server/config.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

# --- hardening (see systemd-analyze security cctv-server.service) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadWritePaths=/var/lib/cctv-server /var/log/cctv-server

LimitNOFILE=65536
LimitNPROC=1024
TasksMax=512

[Install]
WantedBy=multi-user.target
